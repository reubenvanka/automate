# Core ESPHome configuration for AutoMate
# Provides WiFi, API, OTA, logging, and base services

esphome:
  name: ${device_name}
  friendly_name: ${friendly_name}
  project:
    name: "automate.controller"
    version: "1.0.0"
  on_boot:
    then:
      - delay: 100ms
      - script.execute: blink_led
      - delay: 300ms
      - script.execute: blink_led
      - logger.log: "Booted - Restoring device states"
      # Restore all light states from globals
      - lambda: |-
          // Restore Ceiling Light (CCT)
          if (id(ceiling_prev_state)) {
            auto call = id(light_ceiling).turn_on();
            call.set_brightness(id(ceiling_prev_brightness));
            call.set_color_temperature(id(ceiling_prev_color_temp));
            call.perform();
            ESP_LOGD("boot", "Restored Ceiling: On - %s, Brightness - %.0f%%, Temperature - %d K", id(ceiling_prev_state) ? "Yes" : "No", id(ceiling_prev_brightness) * 100, (int)(1000000.0 / id(ceiling_prev_color_temp)));
            id(relay_ceiling_driver).turn_on();  // Restore ceiling driver relay
            id(switch_ceiling_driver).publish_state(true);
            id(ceiling_driver_prev_state) = true;
          } else {
            ESP_LOGD("boot", "No saved Ceiling state, defaulting to off");
            id(relay_ceiling_driver).turn_off();
            id(switch_ceiling_driver).publish_state(false);
            id(ceiling_driver_prev_state) = false;
          }
          // Restore Desk 1 Light (CCT)
          if (id(desk1_prev_state)) {
            auto call = id(light_desk1).turn_on();
            call.set_brightness(id(desk1_prev_brightness));
            call.set_color_temperature(id(desk1_prev_color_temp));
            call.perform();
            ESP_LOGD("boot", "Restored Desk1: On - %s, Brightness - %.0f%%, Temperature - %d K", id(desk1_prev_state) ? "Yes" : "No", id(desk1_prev_brightness) * 100, (int)(1000000.0 / id(desk1_prev_color_temp)));
          } else {
            ESP_LOGD("boot", "No saved Desk1 state, defaulting to off");
          }
          // Restore Desk 2 Light (CCT)
          if (id(desk2_prev_state)) {
            auto call = id(light_desk2).turn_on();
            call.set_brightness(id(desk2_prev_brightness));
            call.set_color_temperature(id(desk2_prev_color_temp));
            call.perform();
            ESP_LOGD("boot", "Restored Desk2: On - %s, Brightness - %.0f%%, Temperature - %d K", id(desk2_prev_state) ? "Yes" : "No", id(desk2_prev_brightness) * 100, (int)(1000000.0 / id(desk2_prev_color_temp)));
          } else {
            ESP_LOGD("boot", "No saved Desk2 state, defaulting to off");
          }
          // Restore Photo Spot Light
          if (id(photo_spot_prev_state)) {
            auto call = id(light_photo_spot).turn_on();
            call.set_brightness(id(photo_spot_prev_brightness));
            call.perform();
            ESP_LOGD("boot", "Restored Photo Spot: On - %s, Brightness - %.0f%%", id(photo_spot_prev_state) ? "Yes" : "No", id(photo_spot_prev_brightness) * 100);
          } else {
            ESP_LOGD("boot", "No saved Photo Spot state, defaulting to off");
          }
          // Restore Wall Bounce Light
          if (id(wall_bounce_prev_state)) {
            auto call = id(light_wall_bounce).turn_on();
            call.set_brightness(id(wall_bounce_prev_brightness));
            call.perform();
            ESP_LOGD("boot", "Restored Wall Bounce: On - %s, Brightness - %.0f%%", id(wall_bounce_prev_state) ? "Yes" : "No", id(wall_bounce_prev_brightness) * 100);
          } else {
            ESP_LOGD("boot", "No saved Wall Bounce state, defaulting to off");
          }
          // Restore Terrace Light
          if (id(terrace_prev_state)) {
            auto call = id(light_terrace).turn_on();
            call.set_brightness(id(terrace_prev_brightness));
            call.perform();
            ESP_LOGD("boot", "Restored Terrace: On - %s, Brightness - %.0f%%", id(terrace_prev_state) ? "Yes" : "No", id(terrace_prev_brightness) * 100);
          } else {
            ESP_LOGD("boot", "No saved Terrace state, defaulting to off");
          }
          // Restore Washroom Light
          if (id(washroom_prev_state)) {
            auto call = id(light_washroom).turn_on();
            call.set_brightness(id(washroom_prev_brightness));
            call.perform();
            ESP_LOGD("boot", "Restored Washroom: On - %s, Brightness - %.0f%%", id(washroom_prev_state) ? "Yes" : "No", id(washroom_prev_brightness) * 100);
          } else {
            ESP_LOGD("boot", "No saved Washroom state, defaulting to off");
          }
      # Restore all relay states from globals
      - lambda: |-
          // Wait for lights to stabilize, then restore relays
          
          // Restore Fan
          if (id(fan_prev_state)) {
            id(relay_fan).turn_on();
            id(switch_fan).publish_state(true);
          } else {
            id(relay_fan).turn_off();
            id(switch_fan).publish_state(false);
          }
          // Restore Ceiling Driver
          if (id(ceiling_driver_prev_state)) {
            id(relay_ceiling_driver).turn_on();
            id(switch_ceiling_driver).publish_state(true);
          } else {
            id(relay_ceiling_driver).turn_off();
            id(switch_ceiling_driver).publish_state(false);
          }
          // Restore 12V Driver - BASED ON ACTUAL LIGHT STATES (not globals)
          // The lights' on_turn_on already turned on relay_12v_driver, but we need to ensure it stays on
          // if any light is on, or turn off if no lights are on
          bool any_light_on = id(light_ceiling).current_values.is_on() || id(light_desk1).current_values.is_on() || id(light_desk2).current_values.is_on() || id(light_photo_spot).current_values.is_on() || id(light_wall_bounce).current_values.is_on() || id(light_terrace).current_values.is_on() || id(light_washroom).current_values.is_on();
          if (any_light_on) {
            id(relay_12v_driver).turn_on();
            id(switch_12v_driver).publish_state(true);
            id(driver12v_prev_state) = true;
            ESP_LOGD("boot", "12V Driver ON - lights are active");
          } else {
            id(relay_12v_driver).turn_off();
            id(switch_12v_driver).publish_state(false);
            id(driver12v_prev_state) = false;
            ESP_LOGD("boot", "12V Driver OFF - no lights active");
          }
          // Restore Voltage Stabilizer
          if (id(stabilizer_prev_state)) {
            id(relay_stabilizer).turn_on();
            id(switch_stabilizer).publish_state(true);
          } else {
            id(relay_stabilizer).turn_off();
            id(switch_stabilizer).publish_state(false);
          }
          // Restore Desk 1
          if (id(desk1_prev_state)) {
            id(relay_desk1).turn_on();
            id(switch_desk1).publish_state(true);
          } else {
            id(relay_desk1).turn_off();
            id(switch_desk1).publish_state(false);
          }
          // Restore Desk 2
          if (id(desk2_prev_state)) {
            id(relay_desk2).turn_on();
            id(switch_desk2).publish_state(true);
          } else {
            id(relay_desk2).turn_off();
            id(switch_desk2).publish_state(false);
          }
          // Restore Desk 3
          if (id(desk3_prev_state)) {
            id(relay_desk3).turn_on();
            id(switch_desk3).publish_state(true);
          } else {
            id(relay_desk3).turn_off();
            id(switch_desk3).publish_state(false);
          }
          // Restore 16A Relay
          if (id(relay_16a_prev_state)) {
            id(relay_16a).turn_on();
            id(switch_16a).publish_state(true);
          } else {
            id(relay_16a).turn_off();
            id(switch_16a).publish_state(false);
          }
          // Restore 30A Relay
          if (id(relay_30a_prev_state)) {
            id(relay_30a).turn_on();
            id(switch_30a).publish_state(true);
          } else {
            id(relay_30a).turn_off();
            id(switch_30a).publish_state(false);
          }
          // Update voltage stabilizer based on desk states
          if (id(switch_desk1).state || id(switch_desk2).state || id(switch_desk3).state) {
            id(relay_stabilizer).turn_on();
            id(switch_stabilizer).publish_state(true);
            id(stabilizer_prev_state) = true;
          }
          // Update ceiling driver based on ceiling light state (already done above)
          ESP_LOGD("boot", "Restored relays: Fan - %s, CeilingDrv - %s, 12V - %s, Stab - %s, Desk1 - %s, Desk2 - %s, Desk3 - %s, 16A - %s, 30A - %s",
            id(fan_prev_state) ? "On" : "Off", id(ceiling_driver_prev_state) ? "On" : "Off",
            id(driver12v_prev_state) ? "On" : "Off", id(stabilizer_prev_state) ? "On" : "Off",
            id(desk1_prev_state) ? "On" : "Off", id(desk2_prev_state) ? "On" : "Off",
            id(desk3_prev_state) ? "On" : "Off", id(relay_16a_prev_state) ? "On" : "Off",
            id(relay_30a_prev_state) ? "On" : "Off");
      - output.turn_off: activity_led  # ensure LED is OFF after boot

esp32:
  board: esp32dev
  framework:
    type: esp-idf

# WiFi configuration (credentials in secrets.yaml)
wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  # No static IP - use DHCP. Reserve a static IP for this device in the router.
  # Enable fallback AP for recovery
  ap:
    ssid: "${friendly_name} Fallback"
    password: !secret fallback_ap_password

# ESPHome native API for Home Assistant
api:
  encryption:
    key: !secret api_encryption_key
  services:
    - service: restore_state
      then:
        - logger.log: "state_manager not ported; restore unavailable"
    - service: save_scene
      variables:
        scene_id: int
        name: string
      then:
        - logger.log: "state_manager not ported; save_scene unavailable"
    - service: load_scene
      variables:
        scene_id: int
      then:
        - logger.log: "state_manager not ported; load_scene unavailable"
    - service: delete_scene
      variables:
        scene_id: int
      then:
        - logger.log: "state_manager not ported; delete_scene unavailable"
    - service: restart
    - service: restart
      then:
        - lambda: |-
            id(esp32).restart();
        - delay: 100ms
        - script.execute: blink_led
# OTA with health-gate
ota:
  platform: esphome
  on_begin:
    then:
      - logger.log: "OTA update starting..."
      - logger.log: "Relays keep their current state during OTA (no forced turn-off)"
  on_end:
    then:
      - logger.log: "OTA update completed"
      - logger.log: "Post-OTA health check not yet implemented (health_check/ota_rollback undefined)"

# Logging
logger:
  level: DEBUG
  baud_rate: 115200

# Enable Home Assistant native API
web_server:
  port: 80
  auth:
    username: !secret web_username
    password: !secret web_password

# Time for scheduling and logging
time:
  - platform: homeassistant
    id: ha_time

# NVS for persistent storage - immediate writes for reliable state restoration
preferences:
  flash_write_interval: 0s

# On-board activity/status LED (GPIO2) - discovered active-HIGH on this DevKit
output:
  - platform: gpio
    id: activity_led
    pin:
      number: GPIO2
      inverted: false   # active-HIGH: HIGH = LED on, LOW = off

script:
  - id: blink_led
    then:
      - output.turn_on: activity_led
      - delay: 150ms
      - output.turn_off: activity_led

# Global substitution values
substitutions:
  device_name: "automate"            # hostname + mDNS -> automate.local
  friendly_name: "AutoMate"